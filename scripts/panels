#!/bin/sh

cache_dir="$HOME"/.cache/hyprlock-cache/style-1
[ ! -d "$cache_dir" ] && mkdir -p "$cache_dir"	# Make cache directory if it's not there

# Load background color dynamically from Brain_Shell matugen if available
if [ -f "$HOME/.config/Brain_Shell/matugen/colors.conf" ]; then
	bg_hex=$(grep -E '^\$background\s*=' "$HOME/.config/Brain_Shell/matugen/colors.conf" | awk '{print $3}')
	[ -n "$bg_hex" ] && background="#$bg_hex" || background="#141318"
else
	background="#141318"
fi

wallpaper="$HOME/.curr_wall_static.jpg"
if [ -f "$wallpaper" ]; then
	magick "$wallpaper" -resize 1920x1080^ -gravity center -extent 1920x1080 "$cache_dir/screenshot.png"
	magick "$wallpaper" -resize "400x400^" -gravity center -extent 400x400 "$cache_dir/avatar.png"
else
	grim "$cache_dir/screenshot.png"
	magick "$cache_dir/screenshot.png" -resize "400x400^" -gravity center -extent 400x400 "$cache_dir/avatar.png"
fi

# Calculate panel slice dimensions and offsets
initial_cutout_size="800x608"
res=$(magick identify -format "%wx%h" "$cache_dir/screenshot.png" 2>/dev/null || echo "1920x1080")
sw=$(echo "$res" | cut -d'x' -f1)
sh=$(echo "$res" | cut -d'x' -f2)
ox=$(( (sw - 800) / 2 ))
oy=$(( (sh - 608) / 2 ))
initial_cutout_offset="${ox}+${oy}"

top_left_offset="0+0"
top_left_size="384x384"

bottom_left_offset="0+416"
bottom_left_size="384x192"

right_offset="416+0"
right_size="384x608"

# Crop screenshot to required size
# Resize to 0.1x, apply size 5 blur, resize to 10x (essentially being 50x blur for less resources used)
# Generate a 0.1x size overlay of $background, 40% alpha and resize it 10x
# Composite it on top of blurred screenshot
# Split top and bottom panels

magick \( "$cache_dir"/screenshot.png -crop "$initial_cutout_size"+"$initial_cutout_offset" -scale 10% -blur 0x5 -resize 1000% +repage \) \
	\( -size "$initial_cutout_size" xc:"$background" -alpha set -channel A -evaluate set 40% \) \
	-composite "$cache_dir"/combi.png
magick "$cache_dir"/combi.png -crop "$top_left_size"+"$top_left_offset" "$cache_dir"/top_left_panel.png
magick "$cache_dir"/combi.png -crop "$bottom_left_size"+"$bottom_left_offset" "$cache_dir"/bottom_left_panel.png
magick "$cache_dir"/combi.png -crop "$right_size"+"$right_offset" "$cache_dir"/right_panel.png
