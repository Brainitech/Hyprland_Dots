#!/bin/sh

cache_dir="$HOME"/.cache/hyprlock-cache/style-1
[ ! -d "$cache_dir" ] && mkdir -p "$cache_dir"	# Make cache directory if it's not there

# Load background color dynamically from Brain_Shell matugen if available
if [ -f "$HOME/.config/Brain_Shell/matugen/colors.conf" ]; then
	bg_hex=$(grep -E '^\$background\s*=' "$HOME/.config/Brain_Shell/matugen/colors.conf" | awk '{print $3}')
	[ -n "$bg_hex" ] && background="#$bg_hex" || background="#141318"
else
	background="#141318"
fi

wallpaper="$HOME/.curr_wall_static.jpg"
state_file="$cache_dir/last_state"
current_wall=$(readlink -f "$wallpaper" 2>/dev/null || echo "$wallpaper")

# Fast bypass: if wallpaper + color haven't changed and cached panels exist, exit immediately
if [ -f "$state_file" ] \
	&& [ -f "$cache_dir/top_left_panel.png" ] \
	&& [ -f "$cache_dir/bottom_left_panel.png" ] \
	&& [ -f "$cache_dir/right_panel.png" ] \
	&& [ -f "$cache_dir/avatar.png" ]; then
	if [ "$current_wall|$background" = "$(cat "$state_file" 2>/dev/null)" ]; then
		exit 0
	fi
fi

# Panel slice dimensions and offsets (based on 1920x1080 canvas)
initial_cutout_size="800x608"
initial_cutout_offset="560+236"

top_left_offset="0+0"
top_left_size="384x384"

bottom_left_offset="0+416"
bottom_left_size="384x192"

right_offset="416+0"
right_size="384x608"

if [ -f "$wallpaper" ]; then
	# Generate 400x400 center-cropped avatar
	magick "$wallpaper" -resize "400x400^" -gravity center -extent 400x400 "$cache_dir/avatar.png"

	# Generate all 3 panels in a single pass without intermediate disk writes
	magick "$wallpaper" -resize 1920x1080^ -gravity center -extent 1920x1080 +gravity \
		-crop "${initial_cutout_size}+${initial_cutout_offset}" +repage \
		-scale 10% -blur 0x5 -resize 1000% \
		\( -size "$initial_cutout_size" xc:"$background" -alpha set -channel A -evaluate set 40% \) -composite \
		\( +clone -crop "${top_left_size}+${top_left_offset}" +repage -write "$cache_dir/top_left_panel.png" +delete \) \
		\( +clone -crop "${bottom_left_size}+${bottom_left_offset}" +repage -write "$cache_dir/bottom_left_panel.png" +delete \) \
		-crop "${right_size}+${right_offset}" +repage "$cache_dir/right_panel.png"
else
	screenshot="$cache_dir/screenshot.png"
	grim "$screenshot"
	magick "$screenshot" -resize "400x400^" -gravity center -extent 400x400 "$cache_dir/avatar.png"
	magick "$screenshot" -resize 1920x1080^ -gravity center -extent 1920x1080 +gravity \
		-crop "${initial_cutout_size}+${initial_cutout_offset}" +repage \
		-scale 10% -blur 0x5 -resize 1000% \
		\( -size "$initial_cutout_size" xc:"$background" -alpha set -channel A -evaluate set 40% \) -composite \
		\( +clone -crop "${top_left_size}+${top_left_offset}" +repage -write "$cache_dir/top_left_panel.png" +delete \) \
		\( +clone -crop "${bottom_left_size}+${bottom_left_offset}" +repage -write "$cache_dir/bottom_left_panel.png" +delete \) \
		-crop "${right_size}+${right_offset}" +repage "$cache_dir/right_panel.png"
	rm -f "$screenshot"
fi

# Clean up obsolete intermediate files if present
rm -f "$cache_dir/screenshot.png" "$cache_dir/combi.png"

# Save state
echo "$current_wall|$background" > "$state_file"
